# =============================================================================
# HyperClova X (NCP Clova Studio)
# =============================================================================
# Task 분류/답변 생성 및 Task5(투자 판단) 분석에 사용되는 LLM API 키
NCP_CLOVASTUDIO_API_KEY=your_clovastudio_api_key_here

# (선택) Clova Studio Chat Completions 엔드포인트. 미설정 시 기본값(HCX-005) 사용
NCP_CLOVASTUDIO_CHAT_URL=https://clovastudio.stream.ntruss.com/testapp/v3/chat-completions/HCX-005

# =============================================================================
# DART (전자공시시스템) - Task5(투자 판단 분석)에서 공시정보 조회에 사용
# =============================================================================
DART_API_KEY=your_dart_api_key_here

# =============================================================================
# Redis Cluster - yfinance 캐시 데이터(2024.01~2025.07) 조회에 사용
# 미설정 시 자동으로 yfinance 실시간 조회로 폴백됩니다.
# =============================================================================
REDIS_HOST=your_redis_host_here
REDIS_PORT=6379
